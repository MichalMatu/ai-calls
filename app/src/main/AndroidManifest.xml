<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- CAPTURE_AUDIO_OUTPUT is intentionally NOT requested here.
         Android reserves it for system components; privileged experiments belong
         behind a dedicated backend/helper instead of pretending it is a normal
         runtime permission. -->

    <application
        android:allowBackup="false"
        android:label="AI Calls"
        android:supportsRtl="true"
        android:localeConfig="@xml/locale_config"
        android:theme="@style/Theme.AiCalls">

        <!-- LiteRT-LM GPU backend probes vendor OpenCL through these optional native libraries. -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.SettingsHubActivity" android:exported="false" />
        <activity android:name=".ui.AgentAiHubActivity" android:exported="false" />
        <activity android:name=".ui.GeneralSettingsActivity" android:exported="false" />
        <activity android:name=".ui.DeveloperToolsActivity" android:exported="false" />
        <activity android:name=".ui.CapabilityDiagnosticsActivity" android:exported="false" />

        <!-- The OS permits exact Call objects only to the user's chosen default dialer. -->
        <service
            android:name=".campaign.AndroidOwnedInCallService"
            android:permission="android.permission.BIND_INCALL_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="true" />
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_RINGING" android:value="true" />
        </service>
        <activity android:name=".incoming.IncomingAssistantSettingsActivity" android:exported="false" />
        <activity android:name=".tools.ConversationToolsActivity" android:exported="false" />
        <activity android:name=".campaign.AndroidCallControlsActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <activity
            android:name=".identity.IdentityVaultManagerActivity"
            android:exported="false" />

        <activity
            android:name=".identity.PhoneEnrollmentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true" />

        <activity
            android:name=".developerrelay.SupervisedCallPilotActivity"
            android:exported="false" />

        <!-- ADB/shell-only observation. Never dials, attaches media or changes call state. -->
        <activity
            android:name=".developerrelay.SupervisedCallReadinessProbeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="android.permission.DUMP" />

        <activity
            android:name=".campaign.AppointmentMvpActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />
        <activity
            android:name=".campaign.ScenarioOutgoingCallActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity android:name=".textagent.LanguageModelActivity" android:exported="false" />
        <service android:name=".textagent.LanguageModelTransferService" android:exported="false" android:foregroundServiceType="dataSync" />
        <service android:name=".audioengines.ParakeetModelTransferService" android:exported="false" android:foregroundServiceType="dataSync" />

        <activity
            android:name=".audioengines.AudioEngineSettingsActivity"
            android:exported="false" />

        <service
            android:name=".campaign.AppOwnedCampaignService"
            android:exported="false"
            android:foregroundServiceType="microphone"
            android:stopWithTask="false" />

        <activity
            android:name=".debug.UsbDebugPanelActivity"
            android:exported="false" />

        <!-- ADB USB only: explicit broadcast does not cover the call controls UI.
             Shell/DUMP permission, debug-APK runtime guard and app-private mailbox. -->
        <receiver
            android:name=".debug.UsbLabControlReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <activity
            android:name=".DiagnosticProbeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="android.permission.DUMP" />

        <activity
            android:name=".GemmaActionRouterProbeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="android.permission.DUMP" />

        <activity
            android:name=".LiveCallReadinessProbeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="android.permission.DUMP" />

        <activity
            android:name=".developerrelay.ChatRelayProbeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="android.permission.DUMP" />
        <activity android:name=".conversation.ScenarioLibraryActivity" android:exported="false" />
        <activity android:name=".conversation.ConversationSkillsActivity" android:exported="false" />
        <activity android:name=".conversation.ConversationSkillLabActivity" android:exported="false" />
        <activity android:name=".conversation.ConversationPreparationActivity" android:exported="false" />
        <activity android:name=".conversation.ConversationHistoryActivity" android:exported="false" />
    </application>

</manifest>
