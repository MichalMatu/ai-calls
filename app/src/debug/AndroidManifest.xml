<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- S8 is a separately named, installable lab app, never the stable dialer.
         Existing debug-only LAN setting remains isolated from release. -->
    <application
        android:usesCleartextTraffic="true"
        android:label="AI Calls S8 Lab"
        tools:replace="android:label">
        <!-- Disabled unless -Ps8NativePrototype=true on an owner-local build.
             May be launched by adb shell only. No SIP account or network. -->
        <activity
            android:name=".developerrelay.S8Pjsua2OfflineLoadSmokeActivity"
            android:enabled="${s8NativeSmokeEnabled}"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:excludeFromRecents="true"
            android:noHistory="true" />
    </application>
</manifest>
