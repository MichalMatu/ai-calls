<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- S8 is a separately named, installable lab app, never the stable dialer.
         Existing debug-only LAN setting remains isolated from release. -->
    <application
        android:usesCleartextTraffic="true"
        android:label="AI Calls S8 Lab"
        tools:replace="android:label">
        <!-- No-call, shell-triggered Binder roundtrip verification. -->
        <activity
            android:name=".developerrelay.S8GsmBinderRoundtripProbeActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:excludeFromRecents="true"
            android:noHistory="true" />
        <!-- Isolated S8 app-owned registration, shell UID only; no Shizuku. -->
        <provider
            android:name=".session.GsmShellBinderRegistryProvider"
            android:authorities="${applicationId}.gsmbinder"
            android:exported="true"
            android:permission="android.permission.DUMP" />


    </application>
</manifest>
