#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/../.."
# Host-only: no ADB, no call, no downloads, no private audio.
if [[ -z "$(printenv ANDROID_HOME || :)" && -d "$HOME/Library/Android/sdk" ]]; then
  export ANDROID_HOME="$HOME/Library/Android/sdk"
fi
if [[ -n "$(printenv ANDROID_HOME || :)" ]]; then export ANDROID_SDK_ROOT="$ANDROID_HOME"; fi
export PYTHONPATH=scripts
lab="$(mktemp -d /tmp/aicalls-gemma-audio-lab.XXXXXX)"
trap 'rm -rf "$lab"' EXIT
python3 -m aicall_tools.diagnostics.gemma_audio_fixture_lab --output "$lab"
python3 -m unittest scripts.tests.diagnostics.test_gemma_audio_fixture_lab -q
python3 scripts/aicall_tools/diagnostics/audit_audio_engine_quality.py
./gradlew --no-daemon :app:testDebugUnitTest \
  --tests pl.michalmatu.aicallbridge.audioengines.SharedGemmaAudioContractTest \
  --tests pl.michalmatu.aicallbridge.audioengines.GemmaAudioPcm16Test \
  --tests pl.michalmatu.aicallbridge.audioengines.ModelAudioCompatibilityReplyTest \
  --tests pl.michalmatu.aicallbridge.textagent.Gemma4LiteRtTextBackendTest \
  --tests pl.michalmatu.aicallbridge.textagent.QueuedGemmaAudioInputTest \
  --tests pl.michalmatu.aicallbridge.textagent.QueuedGemmaAudioLifecycleTest \
  --console=plain
echo "GEMMA_AUDIO_HOST_LAB=PASS"
echo "SYNTHETIC_NON_SPEECH_CASES=4"
echo "ANDROID_NATIVE_INFERENCE=NOT_TESTED"
echo "PRIVATE_PHONE_UNCHANGED=true"
